<h1>Danh Sách Sách</h1>
{{#if error}}<p class="error">{{error}}</p>{{/if}}
<table>
  <thead>
    <tr>
      <th>Mã SP</th>
      <th>Tên sách</th>
      <th>Tác giả</th>
      <th>Giá gốc</th>
      <th>VAT</th>
      <th>Giá sau thuế</th>
    </tr>
  </thead>
  <tbody>
    {{#each books}}
    <tr>
      <td>{{this.code}}</td>
      <td>{{this.title}}</td>
      <td>{{this.author}}</td>
      <td>{{this.price}}</td>
      <td>{{this.vatRate}}%</td>
      <td>{{this.priceAfterTax}}</td>
    </tr>
    {{else}}
    <tr><td colspan="6">Chưa có sách nào.</td></tr>
    {{/each}}
  </tbody>
</table>

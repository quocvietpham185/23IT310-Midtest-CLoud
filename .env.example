PORT=3000

# Thong tin ca nhan hoa (bat buoc)
MSSV=23IT310
FULL_NAME=Pham Quoc Viet

# Dung de ma hoa session cookie - tu sinh chuoi ngau nhien dai
SESSION_SECRET=replace-with-a-long-random-string

# Tai khoan dang nhap de duoc phep them sach (demo auth gate cho stateless session)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# MongoDB Atlas - 2 tai khoan rieng biet, nguyen tac dac quyen toi thieu
# readUser: chi co quyen "read" tren DB_23IT310 (phuc vu GET /books)
# writeUser: co quyen "readWrite" tren DB_23IT310 (phuc vu POST /books/add va luu session)
MONGO_URI_READ=mongodb+srv://<readUser>:<readPassword>@<cluster>.mongodb.net/DB_23IT310?retryWrites=true&w=majority
MONGO_URI_WRITE=mongodb+srv://<writeUser>:<writePassword>@<cluster>.mongodb.net/DB_23IT310?retryWrites=true&w=majority
